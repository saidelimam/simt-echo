<?xml version="1.0" encoding="utf-8"?>
<!--
  ECHO Tap v1 (plan 0005 §4.3/§4.4).

  One proprietary AID, category "other": this is not a payment application,
  it registers no default wallet role, and only ECHO's own foreground reader
  ever selects it. `requireDeviceUnlock` makes the OS refuse the exchange
  while the phone is locked, independently of the in-app check.
-->
<host-apdu-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/echo_tap_service_description"
    android:requireDeviceUnlock="true">

    <aid-group
        android:category="other"
        android:description="@string/echo_tap_aid_group_description">
        <aid-filter android:name="F04543484F01" />
    </aid-group>

</host-apdu-service>
