{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "echo-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Custom domain (W9-01): api.echo.simt.app is declared here, not in
  // the dashboard — redeploy re-attaches it and provisions the cert.
  // workers.dev stays enabled as a fallback route for the same worker.
  "workers_dev": true,
  "routes": [
    { "pattern": "api.echo.simt.app", "custom_domain": true }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "echo-media",
      // R10-02 (review 0010, F2): a 24 h backstop for what the hourly cron
      // (see `triggers`) does not reach in time — terminal job prefixes
      // (inputs, events, SAM evidence, results) and relay ciphertext.
      // Relay objects normally die at their 30 min TTL; jobs at 24 h past
      // a terminal stage. R10-05: the spend ledger is audit residue, kept
      // two days for inspection, then swept.
      "lifecycle_rules": [
        { "id": "expire-jobs", "prefix": "jobs/", "expiration": { "days": 1 } },
        { "id": "expire-relay", "prefix": "relay/", "expiration": { "days": 1 } },
        { "id": "expire-spend", "prefix": "spend/", "expiration": { "days": 2 } }
      ]
    }
  ],
  "workflows": [
    {
      "name": "echo-pipeline",
      "binding": "PIPELINE",
      "class_name": "EchoPipeline"
    }
  ],
  "ratelimits": [
    {
      "name": "RL",
      "namespace_id": "1001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "SCOUT_ORDER": "workers-ai,meta-spark",
    "GROUND_ORDER": "sam31,none",
    "AI_GATEWAY_ID": "echo",
    "WORKERS_AI_MODELS": "@cf/meta/llama-4-scout-17b-16e-instruct,@cf/google/gemma-4-26b-a4b-it",
    // R10-05 (review 0010, F4): daily SAM-frame cap, five jobs at the 240
    // ceiling. SPEND_KILL_SWITCH is intentionally unset — set it to "on"
    // (dashboard var) to halt job creation; see docs/operations/spend.md.
    "DAILY_MAX_SAM_FRAMES": "1200",
    "ENV": "dev"
  },
  // Hourly expiry sweep (R10-02): staged uploads past their 1 h TTL, orphaned
  // idempotency records, terminal jobs past the 24 h retention window, and
  // relay objects past their expiry (see `scheduled` in src/index.ts).
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
