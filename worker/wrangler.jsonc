{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "echo-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Custom domain (W9-01): api.echo.simt.app is declared here, not in
  // the dashboard — redeploy re-attaches it and provisions the cert.
  // workers.dev stays enabled as a fallback route for the same worker.
  "workers_dev": true,
  "routes": [
    { "pattern": "api.echo.simt.app", "custom_domain": true }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "echo-media"
    }
  ],
  "workflows": [
    {
      "name": "echo-pipeline",
      "binding": "PIPELINE",
      "class_name": "EchoPipeline"
    }
  ],
  "ratelimits": [
    {
      "name": "RL",
      "namespace_id": "1001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "SCOUT_ORDER": "workers-ai,meta-spark",
    "GROUND_ORDER": "sam31,none",
    "AI_GATEWAY_ID": "echo",
    "WORKERS_AI_MODELS": "@cf/meta/llama-4-scout-17b-16e-instruct,@cf/google/gemma-4-26b-a4b-it",
    "ENV": "dev"
  },
  // Hourly expiry backstop: sweeps staged uploads past their 1 h TTL and
  // orphaned idempotency records (see `scheduled` in src/index.ts).
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
