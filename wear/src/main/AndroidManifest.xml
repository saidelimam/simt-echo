<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Felt, never seen: every haptic cue in this module. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Declare this is a Wear OS app. -->
    <uses-feature
        android:name="android.hardware.type.watch"
        android:required="true" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- Companion watch app: it only mirrors the phone's haptics. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="false" />

        <!-- Advertises the capability the phone's mirror queries for. -->
        <meta-data
            android:name="com.google.android.wearable.CAPABILITY"
            android:value="echo_wear_app" />

        <activity
            android:name="app.simt.echo.wear.MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Haptic + nav receivers: phone → /echo/haptics → vibration,
             phone → /echo/nav → latest snapshot for MainActivity. -->
        <service
            android:name="app.simt.echo.wear.EchoHapticListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/echo" />
            </intent-filter>
        </service>

    </application>

</manifest>
