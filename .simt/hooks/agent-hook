#!/bin/sh
# Generated by simt-dev. Do not edit.
#
# The harness entry point: every harness config runs this file, never the bare
# `simt` binary, because a harness does not share your shell's PATH. It only
# locates the dispatcher and hands over. Reinstall with:
# simt agent-hooks install --yes
#
# Resolution order is the git shims' order (src/locate.mjs):
#   1. $SIMT_DEV_BIN    explicit override, for CI images and odd checkouts
#   2. node_modules/       the pinned project dependency
#   3. .simt/bin/          the release binary this repository downloaded
#   4. simt on PATH       a global install
#   5. the interpreter that wrote this file, used only when 1-4 all miss
# If none resolves it REFUSES rather than exiting 0.

set -eu

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

# $SIMT_DEV_BIN must name ONE program: an executable on PATH, or a .mjs entry
# point to hand to node. It cannot be a command line, because there is no safe way
# to split one in sh without eval, and a value with a space that names no file is
# refused rather than half-executed - running from a source checkout is normal for
# anyone working on this project itself, so this path has to work with no install step.
#
# Every .mjs entry point goes through run_node, which checks for node first: a GUI
# client's PATH often carries none (nvm is sourced only in an interactive shell), and
# exec node there fails with 127 and no explanation of what to install.
run_node() {
  if ! command -v node >/dev/null 2>&1; then
    echo "simt: cannot find node to run $1." >&2
    echo "  the hook runs a .mjs entry point through node; install Node >= 22.20.0," >&2
    echo "  or set SIMT_DEV_BIN to an executable simt" >&2
    exit 1
  fi
  entry="$1"
  shift
  exec node "$entry" "$@"
}

run_simt_dev() {
  case "$1" in
    *' '*)
      # A space is ambiguous as text and unambiguous as a file: a value that names
      # something on disk is a path in a directory with a space, and runs as one.
      if [ -f "$1" ]; then
        case "$1" in
          *.mjs)
            run_node "$@"
            ;;
          *)
            exec "$@"
            ;;
        esac
      fi
      echo "simt: $SIMT_DEV_BIN names a command line, not a program." >&2
      echo "  set it to a single executable or a .mjs path, e.g." >&2
      echo "    SIMT_DEV_BIN=/path/to/checkout/bin/simt.mjs" >&2
      exit 1
      ;;
    *.mjs)
      run_node "$@"
      ;;
    *)
      exec "$1" "$@"
      ;;
  esac
}

if [ -n "${SIMT_DEV_BIN:-}" ]; then
  run_simt_dev "$SIMT_DEV_BIN" agent-hook "$@" --root "$ROOT"
fi

if [ -f "$ROOT/node_modules/simt-dev/bin/simt.mjs" ]; then
  run_node "$ROOT/node_modules/simt-dev/bin/simt.mjs" agent-hook "$@" --root "$ROOT"
fi

# The binary this repository downloaded for itself: the pinned bytes, no node.
# It is checked before PATH so a repository's own copy wins over whatever a
# machine happens to have installed, the same way node_modules wins - and the
# dispatcher still compares the version it runs against the pin, so a stale
# copy is refused rather than trusted.
if [ -x "$ROOT/.simt/bin/simt" ]; then
  exec "$ROOT/.simt/bin/simt" agent-hook "$@" --root "$ROOT"
fi

if command -v simt >/dev/null 2>&1; then
  exec simt agent-hook "$@" --root "$ROOT"
fi

# 5. The interpreter and entry point that wrote this file, recorded when it was installed.
# A GUI harness starts a hook with a PATH that carries neither nvm nor a local bin - and a
# node is not guaranteed either - so 1-4 all miss on the machine this shim was made for.
if [ -x '/Users/saidelimam/.nvm/versions/node/v26.7.0/bin/node' ] && [ -f '/Users/saidelimam/Documents/GitHub/simt/simt-dev/bin/simt.mjs' ]; then
  exec '/Users/saidelimam/.nvm/versions/node/v26.7.0/bin/node' '/Users/saidelimam/Documents/GitHub/simt/simt-dev/bin/simt.mjs' agent-hook "$@" --root "$ROOT"
fi

echo "simt: cannot locate the agent hook." >&2
# Every expansion in these diagnostics must carry a default. Under `set -eu` an
# unbound variable aborts the shell, so an unguarded $SIMT_DEV_BIN here would
# kill the message that exists to explain the failure - and this block only runs
# when nothing resolved, which is the one moment the reader needs it.
echo "  looked for: ${SIMT_DEV_BIN:-<unset>}, $ROOT/node_modules/simt-dev, $ROOT/.simt/bin/simt, simt on PATH" >&2
# The remedy is assigned single-quoted and echoed, so a command in it - the binary
# download derives its platform with $(uname) - stays text here and runs only when
# the reader runs it. A remedy in double quotes would be half-executed by this echo.
remedy='REMEDY run: mkdir -p .simt/bin && os=$(uname -s | tr A-Z a-z) && arch=$(uname -m | sed "s/x86_64/x64/") && curl -fsSL "https://github.com/QuazarMedia/simt-dev/releases/download/v0.10.0/simt-dev-0.10.0-$os-$arch" -o .simt/bin/simt && chmod +x .simt/bin/simt, or set SIMT_DEV_BIN to the simt binary, or remove the hook entry to opt out'
echo "REMEDY run: mkdir -p .simt/bin && os=$(uname -s | tr A-Z a-z) && arch=$(uname -m | sed "s/x86_64/x64/") && curl -fsSL "https://github.com/QuazarMedia/simt-dev/releases/download/v0.10.0/simt-dev-0.10.0-$os-$arch" -o .simt/bin/simt && chmod +x .simt/bin/simt, or set SIMT_DEV_BIN to the simt binary, or remove the hook entry to opt out" >&2
exit 1
