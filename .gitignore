# Write journal for `simt undo`. Local state, never shared.
.simt/local/

# Per-developer git identity, written by `simt init`. Not a file to share:
# it carries whoever is committing into the tree, and a repository has more than
# one of those.
git.config

# Local secrets (review 0003: live-check key must never be committed)
.env
